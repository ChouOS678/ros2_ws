<?xml version="1.0"?>
<robot name="simple_marl_car">
  <material name="chassis_blue">
    <color rgba="0.20 0.60 0.80 1.0"/>
  </material>
  <material name="trim_dark">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="sensor_orange">
    <color rgba="0.85 0.50 0.20 1.0"/>
  </material>
  <material name="front_highlight">
    <color rgba="0.95 0.80 0.20 1.0"/>
  </material>
  <material name="rear_mark">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.12"/>
    </inertial>

    <visual name="base_body">
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.34 0.14"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>

    <visual name="top_cover">
      <origin xyz="0.02 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.24 0.08"/>
      </geometry>
      <material name="trim_dark"/>
    </visual>

    <visual name="front_nose">
      <origin xyz="0.24 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.30 0.10"/>
      </geometry>
      <material name="front_highlight"/>
    </visual>

    <visual name="rear_panel">
      <origin xyz="-0.25 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.30 0.10"/>
      </geometry>
      <material name="rear_mark"/>
    </visual>

    <visual name="heading_strip">
      <origin xyz="0.14 0 0.245" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.03 0.01"/>
      </geometry>
      <material name="front_highlight"/>
    </visual>

    <collision name="base_collision_main">
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.30 0.14"/>
      </geometry>
    </collision>

    <collision name="base_collision_front">
      <origin xyz="0.16 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.26 0.12"/>
      </geometry>
    </collision>

    <collision name="base_collision_rear">
      <origin xyz="-0.15 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.26 0.12"/>
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <visual name="lidar_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="sensor_orange"/>
    </visual>

    <collision name="lidar_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.16 0 0.16" rpy="0 0 0"/>
  </joint>
</robot>
