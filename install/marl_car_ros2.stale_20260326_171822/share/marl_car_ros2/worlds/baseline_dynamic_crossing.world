<?xml version="1.0"?>
<sdf version="1.8">
  <world name="baseline_dynamic_crossing">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.48 0.48 0.48 1</ambient><diffuse>0.48 0.48 0.48 1</diffuse></material></visual>
      </link>
    </model>

    <model name="corridor_left">
      <static>true</static>
      <pose>4.0 1.15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.8 0.3 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.8 0.3 1.0</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="corridor_right">
      <static>true</static>
      <pose>4.0 -1.15 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8.8 0.3 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.8 0.3 1.0</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="dynamic_crossing_box">
      <pose>4.0 -0.8 0.30 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <inertia>
            <ixx>0.02</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.02</iyy>
            <iyz>0</iyz>
            <izz>0.02</izz>
          </inertia>
          <mass>2.0</mass>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.32 0.32 0.60</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.32 0.32 0.60</size></box></geometry>
          <material>
            <ambient>0.85 0.25 0.25 1</ambient>
            <diffuse>0.85 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
    </model>

    <model name="start_marker"><static>true</static><pose>0.0 0.0 0.01 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.16</radius><length>0.02</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link></model>
    <model name="goal_marker"><static>true</static><pose>8.0 0.0 0.01 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.16</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>
  </world>
</sdf>
