Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: odom
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 160
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /scan
      Color: 0; 255; 0
      Size (Pixels): 3
      Style: Flat Squares
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: BenchmarkReferencePath
      Topic:
        Value: /benchmark/reference_path
      Color: 255; 180; 0
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: RobotTrajectory
      Topic:
        Value: /benchmark/robot_path
      Color: 0; 220; 255
      Line Style: Lines
      Line Width: 0.05
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: BenchmarkMarkers
      Marker Topic:
        Value: /benchmark/markers
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: GlobalPath
      Topic:
        Value: /plan
      Color: 255; 0; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: LocalPath
      Topic:
        Value: /local_plan
      Color: 0; 191; 255
      Line Style: Lines
      Line Width: 0.03
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: odom
      Yaw: 0.6
Window Geometry:
  Height: 900
  Width: 1400
