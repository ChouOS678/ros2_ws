<?xml version="1.0"?>
<sdf version="1.8">
  <model name="simple_marl_car">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.07 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.08</ixx>
          <iyy>0.08</iyy>
          <izz>0.12</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision_main">
        <geometry>
          <box><size>0.30 0.30 0.14</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="base_collision_front">
        <pose>0.16 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.12 0.26 0.12</size></box>
        </geometry>
      </collision>
      <collision name="base_collision_rear">
        <pose>-0.15 0 0 0 0 0</pose>
        <geometry>
          <box><size>0.10 0.26 0.12</size></box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box><size>0.50 0.34 0.14</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.8 1.0</ambient>
          <diffuse>0.2 0.6 0.8 1.0</diffuse>
        </material>
      </visual>
      <visual name="cabin_visual">
        <pose>0.02 0 0.10 0 0 0</pose>
        <geometry>
          <box><size>0.30 0.24 0.08</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.1 1.0</ambient>
          <diffuse>0.08 0.08 0.1 1.0</diffuse>
        </material>
      </visual>
      <visual name="front_nose_visual">
        <pose>0.24 0 -0.01 0 0 0</pose>
        <geometry>
          <box><size>0.04 0.30 0.10</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.80 0.20 1.0</ambient>
          <diffuse>0.95 0.80 0.20 1.0</diffuse>
        </material>
      </visual>
      <visual name="rear_panel_visual">
        <pose>-0.25 0 -0.01 0 0 0</pose>
        <geometry>
          <box><size>0.03 0.30 0.10</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      <visual name="heading_strip_visual">
        <pose>0.14 0 0.145 0 0 0</pose>
        <geometry>
          <box><size>0.18 0.03 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.95 0.80 0.20 1.0</ambient>
          <diffuse>0.95 0.80 0.20 1.0</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel_link">
      <pose>0.0 0.17 0.06 0 0 1.5708</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose>0.0 -0.17 0.06 0 0 1.5708</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
    </link>

    <link name="lidar_link">
      <pose>0.16 0 0.16 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.5 0.2 1.0</ambient>
          <diffuse>0.8 0.5 0.2 1.0</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <visualize>false</visualize>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0.0</min_angle>
              <max_angle>6.28</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <topic>/model/simple_marl_car/cmd_vel</topic>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.06</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
