<?xml version="1.0"?>
<sdf version="1.8">
  <world name="baseline_moderate_curvature_narrow">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.48 0.48 0.48 1</ambient><diffuse>0.48 0.48 0.48 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Outer corridor walls: clear width 3.0m (y = -1.5 to +1.5) -->
    <model name="top_boundary">
      <static>true</static>
      <pose>3.75 1.65 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.5 0.3 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.5 0.3 1.0</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="bottom_boundary">
      <static>true</static>
      <pose>3.75 -1.65 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.5 0.3 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.5 0.3 1.0</size></box></geometry><material><ambient>0.72 0.74 0.78 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- First diverter: blocks lower half, leaves 1.5m above (y: -1.5→0) -->
    <model name="first_diverter">
      <static>true</static>
      <pose>2.3 -0.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 1.5 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 1.5 1.0</size></box></geometry><material><ambient>0.82 0.70 0.42 1</ambient><diffuse>0.82 0.70 0.42 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Second diverter: blocks upper half, leaves 1.5m below (y: 0→1.5) -->
    <model name="second_diverter">
      <static>true</static>
      <pose>5.2 0.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 1.5 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 1.5 1.0</size></box></geometry><material><ambient>0.82 0.70 0.42 1</ambient><diffuse>0.82 0.70 0.42 1</diffuse></material></visual>
      </link>
    </model>

    <model name="start_marker">
      <static>true</static>
      <pose>0.0 0.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.02</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="goal_marker">
      <static>true</static>
      <pose>7.5 0.0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
