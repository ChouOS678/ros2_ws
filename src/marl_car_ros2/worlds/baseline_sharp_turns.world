<?xml version="1.0"?>
<sdf version="1.8">
  <world name="baseline_sharp_turns">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.48 0.48 0.48 1</ambient><diffuse>0.48 0.48 0.48 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Segment 1: straight approach -->
    <model name="s1_top"><static>true</static><pose>1.4 0.65 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.0 0.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>3.0 0.4 1.0</size></box></geometry></visual></link></model>
    <model name="s1_bottom"><static>true</static><pose>1.4 -0.65 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.0 0.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>3.0 0.4 1.0</size></box></geometry></visual></link></model>

    <!-- Segment 2: L-turn vertical channel -->
    <model name="s2_left"><static>true</static><pose>2.15 1.10 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 2.6 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 2.6 1.0</size></box></geometry></visual></link></model>
    <model name="s2_right"><static>true</static><pose>3.45 1.10 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 2.6 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 2.6 1.0</size></box></geometry></visual></link></model>

    <!-- Segment 3: leftward run (sets up hairpin) -->
    <model name="s3_top"><static>true</static><pose>1.8 2.85 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.4 0.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>2.4 0.4 1.0</size></box></geometry></visual></link></model>
    <model name="s3_bottom"><static>true</static><pose>1.8 1.55 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.4 0.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>2.4 0.4 1.0</size></box></geometry></visual></link></model>

    <!-- Segment 4: down turn (hairpin return) -->
    <model name="s4_left"><static>true</static><pose>0.15 1.2 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 2.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 2.4 1.0</size></box></geometry></visual></link></model>
    <model name="s4_right"><static>true</static><pose>1.45 1.2 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.4 2.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 2.4 1.0</size></box></geometry></visual></link></model>

    <!-- Segment 5: final straight after U-turn -->
    <model name="s5_top"><static>true</static><pose>2.3 0.85 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.4 0.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>3.4 0.4 1.0</size></box></geometry><material><ambient>0.80 0.72 0.42 1</ambient><diffuse>0.80 0.72 0.42 1</diffuse></material></visual></link></model>
    <model name="s5_bottom"><static>true</static><pose>2.3 -0.45 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.4 0.4 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>3.4 0.4 1.0</size></box></geometry><material><ambient>0.80 0.72 0.42 1</ambient><diffuse>0.80 0.72 0.42 1</diffuse></material></visual></link></model>

    <model name="start_marker"><static>true</static><pose>0.0 0.0 0.01 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.16</radius><length>0.02</length></cylinder></geometry><material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material></visual></link></model>
    <model name="goal_marker"><static>true</static><pose>3.8 0.2 0.01 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.16</radius><length>0.02</length></cylinder></geometry><material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material></visual></link></model>
  </world>
</sdf>
