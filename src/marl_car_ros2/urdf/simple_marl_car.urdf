<?xml version="1.0"?>
<robot name="simple_marl_car">
  <material name="chassis_blue"><color rgba="0.20 0.60 0.80 1.0"/></material>
  <material name="trim_dark"><color rgba="0.08 0.08 0.10 1.0"/></material>
  <material name="wheel_dark"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="sensor_orange"><color rgba="0.80 0.50 0.20 1.0"/></material>
  <material name="camera_black"><color rgba="0.02 0.02 0.02 1.0"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.0363" ixy="0.0" ixz="0.0" iyy="0.0867" iyz="0.0" izz="0.1037"/>
    </inertial>
    <visual name="base_visual"><origin xyz="0 0 0.02"/><geometry><box size="0.34 0.20 0.12"/></geometry><material name="chassis_blue"/></visual>
    <visual name="top_cover_visual"><origin xyz="0 0 0.10"/><geometry><box size="0.25 0.16 0.04"/></geometry><material name="trim_dark"/></visual>
    <collision name="base_collision"><origin xyz="0 0 0.02"/><geometry><box size="0.34 0.20 0.12"/></geometry></collision>
  </link>

  <link name="front_left_wheel_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.6"/><inertia ixx="0.000554" ixy="0.0" ixz="0.0" iyy="0.0009075" iyz="0.0" izz="0.000554"/></inertial>
    <visual name="front_left_wheel_visual"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry><material name="wheel_dark"/></visual>
    <collision name="front_left_wheel_collision"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry></collision>
  </link>
  <link name="front_right_wheel_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.6"/><inertia ixx="0.000554" ixy="0.0" ixz="0.0" iyy="0.0009075" iyz="0.0" izz="0.000554"/></inertial>
    <visual name="front_right_wheel_visual"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry><material name="wheel_dark"/></visual>
    <collision name="front_right_wheel_collision"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry></collision>
  </link>
  <link name="rear_left_wheel_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.6"/><inertia ixx="0.000554" ixy="0.0" ixz="0.0" iyy="0.0009075" iyz="0.0" izz="0.000554"/></inertial>
    <visual name="rear_left_wheel_visual"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry><material name="wheel_dark"/></visual>
    <collision name="rear_left_wheel_collision"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry></collision>
  </link>
  <link name="rear_right_wheel_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.6"/><inertia ixx="0.000554" ixy="0.0" ixz="0.0" iyy="0.0009075" iyz="0.0" izz="0.000554"/></inertial>
    <visual name="rear_right_wheel_visual"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry><material name="wheel_dark"/></visual>
    <collision name="rear_right_wheel_collision"><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.055" length="0.045"/></geometry></collision>
  </link>

  <link name="laser_link">
    <visual name="laser_visual"><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="sensor_orange"/></visual>
    <collision name="laser_collision"><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
  </link>
  <link name="camera_link">
    <visual name="camera_visual"><geometry><box size="0.06 0.05 0.04"/></geometry><material name="camera_black"/></visual>
    <collision name="camera_collision"><geometry><box size="0.06 0.05 0.04"/></geometry></collision>
  </link>

  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.055"/></joint>
  <joint name="front_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_left_wheel_link"/><origin xyz="0.11 0.13 0"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="front_right_wheel_link"/><origin xyz="0.11 -0.13 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel_link"/><origin xyz="-0.11 0.13 0"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel_link"/><origin xyz="-0.11 -0.13 0"/><axis xyz="0 1 0"/></joint>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0 0 0.195"/></joint>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.16 0 0.08"/></joint>

  <gazebo reference="front_left_wheel_link"><mu1>1.35</mu1><mu2>0.20</mu2><fdir1>1 0 0</fdir1><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>
  <gazebo reference="front_right_wheel_link"><mu1>1.35</mu1><mu2>0.20</mu2><fdir1>1 0 0</fdir1><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>
  <gazebo reference="rear_left_wheel_link"><mu1>1.35</mu1><mu2>0.20</mu2><fdir1>1 0 0</fdir1><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>
  <gazebo reference="rear_right_wheel_link"><mu1>1.35</mu1><mu2>0.20</mu2><fdir1>1 0 0</fdir1><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>

  <gazebo reference="laser_link">
    <sensor name="laser" type="gpu_lidar">
      <always_on>true</always_on><update_rate>15.0</update_rate><visualize>false</visualize><topic>/scan</topic><gz_frame_id>laser_link</gz_frame_id>
      <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.1</min><max>12.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise></ray>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="rgbd_camera">
      <always_on>true</always_on><update_rate>15.0</update_rate><visualize>false</visualize><topic>/camera</topic><gz_frame_id>camera_link</gz_frame_id>
      <camera name="front_depth_camera">
        <horizontal_fov>1.089</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>12.0</far></clip>
        <depth_camera><clip><near>0.1</near><far>12.0</far></clip></depth_camera>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <topic>/model/simple_marl_car/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/model/simple_marl_car/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      <left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.26</wheel_separation><wheel_radius>0.055</wheel_radius><odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>
</robot>
